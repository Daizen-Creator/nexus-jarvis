{
  "name": "nexus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "description": "NEXUS — interface J.A.R.V.I.S. x Sistema (Solo Leveling), com assistente de voz offline em segundo plano.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p electron --noEmit",
    "build:electron": "tsc -p electron && node scripts/postbuild-electron.cjs",
    "dev:desktop": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "desktop": "npm run build && npm run build:electron && electron .",
    "desktop:fast": "electron .",
    "dist": "npm run build && npm run build:electron && electron-builder",
    "release": "npm run build && npm run build:electron && electron-builder --publish always",
    "voice:setup": "python -m pip install -r python/requirements.txt && python python/download_model.py",
    "voice:devices": "python python/nexus_voice.py --list-devices"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nexus.jarvis",
    "productName": "NEXUS",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NEXUS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "NEXUS-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Daizen-Creator",
        "repo": "nexus-jarvis"
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  }
}
